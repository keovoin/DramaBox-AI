rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Dramas collection (Public read for all users; write allowed for uploads)
    match /dramas/{dramaId} {
      allow read, write: if true;
    }

    // Users collection (Allowed for both Google authenticated and manual/guest accounts)
    match /users/{userId} {
      allow read, write: if true;

      // User subcollections: favorites and history
      match /favorites/{dramaId} {
        allow read, write: if true;
      }

      match /history/{historyId} {
        allow read, write: if true;
      }
    }
  }
}
