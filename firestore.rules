rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Dramas collection:
    // - Listing (reading the collection) must be public so ANY visitor can load the catalog
    // - Reading/writing individual docs: read public, write admin-only (keovoin@gmail.com)
    match /dramas {
      allow read: if true;
    }
    match /dramas/{dramaId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == "keovoin@gmail.com";
    }

    // Users collection
    // Collection-level read for the admin dashboard's live list query
    // (collection snapshots need a rule on /users itself, not just /users/{id}).
    match /users {
      allow read: if request.auth != null && request.auth.token.email == "keovoin@gmail.com";
    }
    match /users/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || request.auth.token.email == "keovoin@gmail.com");

      match /favorites/{dramaId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /history/{historyId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Promo codes: public read (checkout validates codes client-side),
    // admin-only create/delete, and redemption updates restricted to the
    // usage-counter fields only (done via the server relay with this key).
    match /promoCodes {
      allow read: if true;
    }
    match /promoCodes/{codeId} {
      allow read: if true;
      allow create, delete: if request.auth != null && request.auth.token.email == "keovoin@gmail.com";
      allow update: if request.auth != null && request.auth.token.email == "keovoin@gmail.com"
        // Server relay (admin SDK key) bypasses these rules entirely.
        || (request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['usedCount', 'redeemedBy', 'updatedAt'])
           && request.resource.data.usedCount == resource.data.usedCount + 1);
    }
  }
}
