# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="https://urdrama.com"

# CUTLUY PAYMENT GATEWAY
# Note: CutLuy only strictly requires your API Secret Key (ck_live_...).
# Merchant ID and Webhook Secret default automatically and are optional.
CUTLUY_API_KEY=""
CUTLUY_MERCHANT_ID="STORE_MERCHANT"
CUTLUY_WEBHOOK_SECRET=""

# SENGHONGSTORE PAYMENT GATEWAY
# Bearer Secret Token (sk_...) for SenghongStore API
SENGHONG_API_KEY=""

# GOOGLE OAUTH CREDENTIALS (Optional for custom domain auth)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
